# Copy this file to .env.local for local development. Never commit .env.local.

# --- Sign-in (required in production) -------------------------------------
# Secret used to sign the session cookie. At least 32 characters.
# Generate one with:  openssl rand -base64 48
# In development a built-in fallback is used if this is empty; in production
# the app refuses to start a session without it.
AUTH_SECRET=

# --- "Continue with Google" (optional, free) ------------------------------
# Leave both empty to show only email + password sign-in.
# Create the credentials in Google Cloud Console -> APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID -> Web application. See DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the public address of the site, e.g. https://fieldnotes.example.com
# Only needed if the app sits behind a proxy that hides its real address.
# The Google redirect URI is then  <AUTH_URL>/api/auth/google/callback
AUTH_URL=

# --- Database (required on Vercel) ----------------------------------------
# Postgres connection string (for example from Neon). When empty, the app uses
# a local SQLite file in ./data, which is fine for development only.
DATABASE_URL=

# --- Trata engine (optional, runs on your own computer; see engine/README.md) ---
# Address of the engine started with engine\start-engine.bat. Default shown.
# The engine does the Hindi/English speech-to-text and the Trata-focused analysis.
# If it is not running, the website falls back to the in-browser model.
ENGINE_URL=http://127.0.0.1:8765
# Only needed if you set ENGINE_TOKEN for the engine (required when it is not on this computer).
ENGINE_TOKEN=
